# Configuration pour développement local
# Copier ce fichier en .env.local et remplir les valeurs

# Clé API Groq (gratuite) pour le parsing intelligent de requêtes
# Obtenez votre clé sur: https://console.groq.com/keys
VITE_GROQ_API_KEY=your-groq-api-key-here

# Backend Laravel : par défaut le dev utilise http://127.0.0.1:8000 (proxy Vite + ordre dans environment.ts)
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Cible du proxy Vite uniquement (sans /api) :
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
